VITE_MOCK_PASSKEY=true
# Optional: leave blank to generate a mock private key at startup.
VITE_MOCK_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
# Optional: Mt Pelerin onramp configuration. The app falls back to Mt Pelerin's localhost test key when blank.
VITE_MT_PELERIN_INTEGRATION_KEY=
VITE_MT_PELERIN_DEFAULT_FIAT=USD
VITE_MT_PELERIN_PRIMARY_COLOR=#111111
VITE_MT_PELERIN_SUCCESS_COLOR=#111111
VITE_MT_PELERIN_REFERRAL_CODE=
# Optional: Pimlico-compatible RPC if you want ERC-20 gas (e.g. USDC), for example:
# VITE_MAINNET_BUNDLER_URL=https://api.pimlico.io/v2/1/rpc?apikey=YOUR_PIMLICO_API_KEY
# VITE_SEPOLIA_BUNDLER_URL=https://api.pimlico.io/v2/11155111/rpc?apikey=YOUR_PIMLICO_API_KEY
VITE_MAINNET_BUNDLER_URL=
VITE_SEPOLIA_BUNDLER_URL=
